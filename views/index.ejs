<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Blog</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>

    <h1>My Blog</h1>
    <p>Creating and sharing blog posts</p>

    </header>

    <main>

        <section>

            <h2>
                CREATE A POST
            </h2>

            <form action="/posts" method="POST">

                <div>
                    <label for="author">
                        NAME
                    </label>

                    <input type="text" id="author" name="author" required>
                </div>

                <div>
                    <label for="title">
                        TITLE
                    </label>

                    <input type="text" id="title" name="title" required>
                </div>

                <div>
                    <label for="content">
                        BLOG
                    </label>

                    <textarea id="content" name="content" rows="8" required>

                    </textarea>
                </div>

                <button type="submit">
                    POST
                </button>

            </form>

        </section>

    </main>
</body>

</html>